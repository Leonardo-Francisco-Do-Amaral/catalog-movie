# Servidor
PORT=3000

# Banco de Dados PostgreSQL na nuvem (Neon / Render) - quando definido, usa SSL automaticamente
DATABASE_URL=

# Banco de Dados PostgreSQL Local (fallback quando DATABASE_URL não está definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=movie_catalog

# Bloqueio por PIN do site e das rotas de escrita da API (padrão: leoholycinema)
APP_PASSWORD=leoholycinema

# Integrações de APIs de Cinema
TMDB_API_KEY=sua_tmdb_api_key
TMDB_BEARER_TOKEN=seu_tmdb_bearer_token
OMDB_API_KEY=sua_omdb_api_key

# Módulo Isolado de Animes, Séries & Doramas (false para versão comercial Só Filmes)
ENABLE_ANIME_MODULE=true
